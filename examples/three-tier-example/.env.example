# Copy to .env and fill in. The driver scripts (scripts/plan.sh, apply.sh,
# destroy.sh) auto-load this file if it exists. It is git-ignored, so secrets
# stay local. Values here are exported into the environment; _env.sh then
# surfaces the DuploCloud creds to terraform as TF_VAR_* (see README.md).

# ── DuploCloud credentials (required) ──────────────────────────────────────
duplo_host=https://your-portal.duplocloud.net
duplo_token=dahp_replace_with_your_token        # or leave unset and use duplo-jit

# ── optional ───────────────────────────────────────────────────────────────
# Disable TLS verification (dev only).
ssl_no_verify=false

# Path to a .tfvars/.tfvars.json applied to EVERY tier (in addition to the
# per-tier config/<tier>.tfvars files that are auto-loaded).
# var_file=config/common.tfvars

# terraform -parallelism (low value avoids DuploCloud API timeouts).
# TF_PARALLELISM=1

# Set to 1 to skip the destroy confirmation prompt (non-interactive teardown).
# AUTO_APPROVE=1
